{
  "expo": {
    "name": "Contracting App",
    "slug": "contracts-portal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/contracting-app.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sitebatch.contractingapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/contracting-app.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.sitebatch.contractingapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "contractsapp",
    "extra": {
      "eas": {
        "projectId": "18147424-66e5-474a-8390-ffdfa94162af"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/contracting-app.png",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-status-bar"
    ]
  }
}
